{
  "name": "opentax",
  "private": true,
  "description": "Open source, local-first alternative to TurboTax and H&R Block",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @opentax/web",
    "build": "npm run build -w @opentax/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
